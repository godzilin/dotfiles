{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "backlight", "network", "power-profiles-daemon", "battery", "custom/notifications", "custom/power"],

    "custom/launcher": {
        "format": "<span color='#e9a23b'>▮</span> COMPUTAH",
        "on-click": "pkill fuzzel || fuzzel",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "01", "2": "02", "3": "03", "4": "04", "5": "05",
            "6": "06", "7": "07", "8": "08", "9": "09", "default": "··"
        },
        "persistent-workspaces": { "*": 4 },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 48,
        "separate-outputs": true
    },
    "clock": {
        "locale": "es_ES.utf8",
        "format": "{:L%a %d %b  <span color='#e8dfc8'>%H:%M</span>}",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/calendar.sh",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#e8dfc8'><b>{}</b></span>",
                "weekdays": "<span color='#857c69'>{}</span>",
                "today": "<span color='#e9a23b'><b>{}</b></span>"
            }
        }
    },
    "tray": { "icon-size": 14, "spacing": 8 },
    "pulseaudio": {
        "format": "<span color='#857c69'>VOL</span> {volume}",
        "format-muted": "<span color='#857c69'>VOL</span> <span color='#c8553d'>MUTE</span>",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },
    "backlight": {
        "format": "<span color='#857c69'>LUM</span> {percent}"
    },
    "network": {
        "format-wifi": "<span color='#857c69'>NET</span> {essid}",
        "format-ethernet": "<span color='#857c69'>NET</span> ETH",
        "format-disconnected": "<span color='#857c69'>NET</span> <span color='#c8553d'>OFF</span>",
        "tooltip-format": "{ifname}  {ipaddr}  {signalStrength}%",
        "on-click": "systemsettings kcm_networkmanagement"
    },
    "power-profiles-daemon": {
        "format": "<span color='#857c69'>PWR</span> {icon}",
        "format-icons": {
            "default": "BAL",
            "performance": "MAX",
            "balanced": "BAL",
            "power-saver": "ECO"
        }
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "<span color='#857c69'>BAT</span> {capacity}",
        "format-charging": "<span color='#857c69'>BAT</span> {capacity}<span color='#e9a23b'>+</span>",
        "format-plugged": "<span color='#857c69'>BAT</span> {capacity}<span color='#e9a23b'>=</span>",
        "tooltip-format": "{timeTo}  ·  {power:.1f} W"
    },
    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "<span color='#e9a23b'>●</span>",
            "none": "○",
            "dnd-notification": "<span color='#e9a23b'>◐</span>",
            "dnd-none": "◐"
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/hypr/scripts/powermenu.sh",
        "tooltip": false
    }
}
