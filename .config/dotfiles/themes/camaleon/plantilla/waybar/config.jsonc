// Camaleón: slim rounded pills floating on the wallpaper, coloured by it; Roman numerals for the desktops
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 8,

    "modules-left": ["group/home"],
    "modules-center": ["clock"],
    "modules-right": ["hyprland/window", "tray", "group/status", "group/end"],

    "group/home": { "orientation": "horizontal", "modules": ["custom/launcher", "hyprland/workspaces", "custom/weather", "group/media"] },
    "group/status": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "backlight", "network", "bluetooth", "power-profiles-daemon", "battery"]
    },
    "group/end": { "orientation": "horizontal", "modules": ["custom/wallpaper", "custom/claude", "custom/notifications", "custom/power"] },

    // Now playing: cover, prev / play-pause / next, title + progress. Click cover or text for the popup.
    "group/media": {
        "orientation": "horizontal",
        "modules": ["image#cover", "custom/media-prev", "mpris", "custom/media-next", "custom/media"]
    },
    "image#cover": {
        "exec": "cat ~/.cache/nostromo/cover-path 2>/dev/null | grep . || echo /nonexistent",
        "size": 20,
        "interval": 5,
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/media.sh"
    },
    "custom/claude": {
        "exec": "~/.config/hypr/scripts/claude-spin.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": true
    },

    "custom/media-prev": {
        "exec": "echo 󰒮",
        "exec-if": "playerctl status",
        "interval": 2,
        "on-click": "playerctl previous",
        "tooltip": false
    },
    "mpris": {
        "format": "{status_icon}",
        "status-icons": { "playing": "󰏤", "paused": "󰐊" },
        "tooltip": false
    },
    "custom/media-next": {
        "exec": "echo 󰒭",
        "exec-if": "playerctl status",
        "interval": 2,
        "on-click": "playerctl next",
        "tooltip": false
    },
    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.py",
        "restart-interval": 2,  // libplayerctl aborts the script if a player dies abruptly; respawn it
        "return-type": "json",
        "escape": false,
        "on-click": "~/.config/hypr/scripts/media.sh"
    },

    // Weather (Open-Meteo): icon + °C; click for the full forecast
    "custom/weather": {
        "exec": "~/.config/hypr/scripts/weather.py bar",
        "return-type": "json",
        "interval": 600,
        "on-click": "~/.config/hypr/scripts/weather.sh"
    },

    // Bluetooth: click toggles power, right click opens the KDE Bluetooth settings
    "bluetooth": {
        "format": "<span color='#{{muted}}'>󰂯</span>",
        "format-on": "<span color='#{{muted}}'>󰂯</span>",
        "format-off": "<span color='#{{muted}}'>󰂲</span>",
        "format-disabled": "<span color='#{{muted}}'>󰂲</span>",
        "format-connected": "<span color='#{{accent}}'>󰂯</span> {device_alias}",
        "format-connected-battery": "<span color='#{{accent}}'>󰂯</span> {device_alias} {device_battery_percentage}%",
        "max-length": 60,  // counts the colour markup too
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{controller_alias} · {num_connections} conectado(s)\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
        "on-click-right": "systemsettings kcm_bluetooth"
    },

    "custom/launcher": {
        "format": "<span color='#{{accent}}'>󰣇</span>",
        "on-click": "pkill fuzzel || fuzzel",
        "tooltip": false
    },
    // Roman numerals; the second monitor's 11-19 show as I-IX (hosts/pcgodzilin.lua)
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "I", "2": "II", "3": "III", "4": "IV", "5": "V", "6": "VI", "7": "VII", "8": "VIII", "9": "IX",
            "11": "I", "12": "II", "13": "III", "14": "IV", "15": "V", "16": "VI", "17": "VII", "18": "VIII", "19": "IX",
            "default": "·"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },
    "clock": {
        "locale": "es_ES.utf8",
        "format": "{:L%A %d de %B  <span font_family='Fraunces' color='#{{text}}' weight='600'>%H:%M</span>}",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/calendar.sh"
    },
    "tray": { "icon-size": 15, "spacing": 10 },
    "pulseaudio": {
        "format": "<span color='#{{muted}}'>󰕾</span> {volume}",
        "format-muted": "<span color='#{{red}}'>󰝟</span>",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },
    "backlight": { "format": "<span color='#{{muted}}'>󰃠</span> {percent}" },
    "network": {
        "format-wifi": "<span color='#{{muted}}'>󰖩</span> {essid}",
        "format-ethernet": "<span color='#{{muted}}'>󰈀</span>",
        "format-disconnected": "<span color='#{{red}}'>󰖪</span>",
        "tooltip-format": "{ifname}  {ipaddr}  {signalStrength}%",
        "on-click": "systemsettings kcm_networkmanagement"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": { "default": "<span color='#{{muted}}'>󰗑</span>", "performance": "<span color='#{{orange}}'>󰓅</span>", "balanced": "<span color='#{{muted}}'>󰗑</span>", "power-saver": "<span color='#{{accent}}'>󰌪</span>" }
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "<span color='#{{muted}}'>󰁹</span> {capacity}%",
        "format-charging": "<span color='#{{accent}}'>󰂄</span> {capacity}%",
        "format-plugged": "<span color='#{{accent}}'>󰂄</span> {capacity}%",
        "tooltip-format": "{timeTo}  ·  {power:.1f} W"
    },
    "custom/wallpaper": {
        "format": "󰸉",
        "on-click": "~/.config/hypr/scripts/wallpaper.sh",
        "tooltip-format": "Fondo de pantalla"
    },
    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "<span color='#{{accent}}'>●</span>",
            "none": "○",
            "dnd-notification": "<span color='#{{accent}}'>◐</span>",
            "dnd-none": "◐"
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/hypr/scripts/powermenu.sh",
        "tooltip": false
    }
}
