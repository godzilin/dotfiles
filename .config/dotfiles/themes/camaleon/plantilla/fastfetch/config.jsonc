{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "",
    "key": { "width": 11 },
    "color": { "keys": "white", "title": "green", "output": "default" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[90m────────────────────────────\u001b[0m" },
    { "type": "os",       "key": "sistema",     "format": "{pretty-name}" },
    { "type": "kernel",   "key": "núcleo" },
    { "type": "wm",       "key": "ventanas",     "format": "{pretty-name}" },
    { "type": "shell",    "key": "shell",  "format": "{pretty-name}" },
    { "type": "cpu",      "key": "cpu",    "format": "{name}" },
    { "type": "memory",   "key": "memoria",    "format": "{used} / {total}" },
    { "type": "disk",     "key": "disco",   "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "battery",  "key": "batería",    "format": "{capacity}" },
    { "type": "uptime",   "key": "despierto" }
  ]
}
