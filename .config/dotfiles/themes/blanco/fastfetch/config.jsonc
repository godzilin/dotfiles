{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Arch logo striped like the 1977 rainbow (make_logo.py), keys in plain "About This Mac" wording
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;97;187;70", "2": "38;2;253;184;39", "3": "38;2;245;130;31", "4": "38;2;224;58;62", "5": "38;2;150;61;151", "6": "38;2;0;157;220" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 12 },
    "color": { "keys": "bright_black", "title": "default", "output": "default" }
  },
  "modules": [
    { "type": "title", "format": "\u001b[1m{host-name}\u001b[0m" },
    { "type": "custom", "format": "" },
    { "type": "host",     "key": "Modelo",   "format": "{family}" },
    { "type": "cpu",      "key": "Chip",     "format": "{name}" },
    { "type": "memory",   "key": "Memoria",  "format": "{total}" },
    { "type": "disk",     "key": "Disco",    "folders": "/", "format": "{size-used} de {size-total}" },
    { "type": "os",       "key": "Sistema",  "format": "{pretty-name}" },
    { "type": "kernel",   "key": "Kernel" },
    { "type": "battery",  "key": "Batería",  "format": "{capacity}" },
    { "type": "uptime",   "key": "Activo" }
  ]
}
