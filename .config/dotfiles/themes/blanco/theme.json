{
  "name": "Blanco",
  "description": "macOS: claro, translúcido, barra de menús arriba y Dock abajo",
  "palette": {
    "bg0": "#ffffff",
    "bg": "#f6f6f6",
    "bg1": "#ececec",
    "bg2": "#c7c7cc",
    "line": "#aeaeb2",
    "faint": "#8e8e93",
    "muted": "#6e6e73",
    "sub": "#3c3c43",
    "text": "#1d1d1f",
    "accent": "#007aff",
    "yellow": "#b58200",
    "orange": "#ff9500",
    "red": "#ff3b30",
    "green": "#34c759",
    "teal": "#30b0c7",
    "blue": "#007aff"
  },
  "stripes": [
    "#aeaeb2",
    "#aeaeb2",
    "#aeaeb2",
    "#aeaeb2"
  ],
  "font_ui": "Inter",
  "font_mono": "DejaVu Sans Mono",
  "font_size": 10,
  "gtk_theme": "WhiteSur-Light",
  "color_scheme": "prefer-light",
  "icons": "WhiteSur-Linux",
  "cursor": "WhiteSur-cursors",
  "cursor_size": 24,
  "kde_colors": "Blanco",
  "buttons": "close,minimize,maximize:",
  "daemons": [
    "nwg-dock-hyprland -d -i 48 -mb 8 -nolauncher -g 'nostromo-calendar nostromo-weather nostromo-media about-this-pc'"
  ],
  "vscode": {
    "settings": {
      "window.menuBarVisibility": "toggle", "window.controlsStyle": "hidden",
      "workbench.activityBar.location": "top", "workbench.layoutControl.enabled": false,
      "workbench.editor.tabActionLocation": "left", "editor.minimap.enabled": false
    },
    "colors": {
      "editor.selectionBackground": "#b3d7ff", "editor.lineHighlightBackground": "#f4f7fb",
      "editorLineNumber.foreground": "#aeaeb2", "editorLineNumber.activeForeground": "#1d1d1f",
      "tab.activeBorderTop": "#00000000", "tab.inactiveBackground": "#e3e3e6",
      "activityBar.background": "#ececec", "activityBar.foreground": "#1d1d1f",
      "activityBarBadge.background": "#ff3b30", "activityBarBadge.foreground": "#ffffff",
      "badge.background": "#ff3b30", "badge.foreground": "#ffffff",
      "sideBar.background": "#ececec", "editorGroupHeader.tabsBackground": "#ececec",
      "titleBar.activeBackground": "#ececec",
      "list.activeSelectionBackground": "#007aff", "list.activeSelectionForeground": "#ffffff",
      "list.activeSelectionIconForeground": "#ffffff", "list.focusOutline": "#00000000",
      "statusBar.background": "#f6f6f6", "statusBar.foreground": "#6e6e73"
    },
    "tokens": {
      "comments": "#5d6c79", "keywords": "#9b2393", "strings": "#c41a16", "numbers": "#1c00cf",
      "types": "#0b4f79", "functions": "#326d74"
    }
  },
  "wallpaper": {
    "title": "Fondo de pantalla",
    "random": "Aleatorio"
  }
}
