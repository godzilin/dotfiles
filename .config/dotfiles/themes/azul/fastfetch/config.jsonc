{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Arch logo in the four panes of the waving flag (make_logo.py); keys as in "Propiedades del sistema"
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;255;0;0", "2": "38;2;0;170;0", "3": "38;2;0;0;255", "4": "38;2;255;204;0" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 12 },
    "color": { "keys": "white", "title": "bright_white", "output": "default" }
  },
  "modules": [
    { "type": "title", "format": "Sistema: {user-name}@{host-name}" },
    { "type": "custom", "format": "" },
    { "type": "os",       "key": "Sistema",   "format": "{pretty-name}" },
    { "type": "kernel",   "key": "Versión" },
    { "type": "host",     "key": "Equipo",    "format": "{family}" },
    { "type": "cpu",      "key": "Procesador", "format": "{name}" },
    { "type": "memory",   "key": "Memoria",   "format": "{total} de RAM" },
    { "type": "disk",     "key": "/",        "folders": "/", "format": "{size-used} de {size-total}" },
    { "type": "battery",  "key": "Batería",   "format": "{capacity}" },
    { "type": "uptime",   "key": "Encendido" }
  ]
}
