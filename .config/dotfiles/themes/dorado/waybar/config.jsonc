{
    "layer": "top",
    "position": "top",
    "height": 33,
    "spacing": 0,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "custom/weather", "group/media"],
    "modules-center": ["custom/luna", "clock"],
    "modules-right": ["hyprland/window", "tray", "pulseaudio", "backlight", "network", "bluetooth", "power-profiles-daemon", "battery", "custom/wallpaper", "custom/claude", "custom/notifications", "custom/power"],

    // Now playing: cover, prev / play-pause / next, title + progress. Click cover or text for the popup.
    "group/media": {
        "orientation": "horizontal",
        "modules": ["image#cover", "custom/media-prev", "mpris", "custom/media-next", "custom/media"]
    },
    "image#cover": {
        "exec": "cat ~/.cache/nostromo/cover-path 2>/dev/null | grep . || echo /nonexistent",
        "size": 20,
        "interval": 5,
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/media.sh"
    },
    "custom/claude": {
        "exec": "~/.config/hypr/scripts/claude-spin.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": true
    },

    "custom/media-prev": {
        "exec": "echo ‹",
        "exec-if": "playerctl status",
        "interval": 2,
        "on-click": "playerctl previous",
        "tooltip": false
    },
    "mpris": {
        "format": "{status_icon}",
        "status-icons": { "playing": "‖", "paused": "▸" },
        "tooltip": false
    },
    "custom/media-next": {
        "exec": "echo ›",
        "exec-if": "playerctl status",
        "interval": 2,
        "on-click": "playerctl next",
        "tooltip": false
    },
    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.py",
        "restart-interval": 2,  // libplayerctl aborts the script if a player dies abruptly; respawn it
        "return-type": "json",
        "escape": false,
        "on-click": "~/.config/hypr/scripts/media.sh"
    },

    // The almanac line beside the clock: real phase of the Moon and the sign the Sun is in
    "custom/luna": {
        "exec": "~/.config/dotfiles/themes/current/scripts/luna.py",
        "return-type": "json",
        "interval": 1800
    },

    // Weather (Open-Meteo): icon + °C; click for the full forecast
    "custom/weather": {
        "exec": "~/.config/hypr/scripts/weather.py bar",
        "return-type": "json",
        "interval": 600,
        "on-click": "~/.config/hypr/scripts/weather.sh"
    },

    // Bluetooth readout: click toggles power, right click opens the KDE Bluetooth settings
    "bluetooth": {
        "format": "<span font_family='Alegreya Sans SC' color='#858b9a'>bt</span> {status}",
        "format-on": "<span font_family='Alegreya Sans SC' color='#858b9a'>bt</span> sí",
        "format-off": "<span font_family='Alegreya Sans SC' color='#858b9a'>bt</span> no",
        "format-disabled": "<span font_family='Alegreya Sans SC' color='#858b9a'>bt</span> no",
        "format-connected": "<span font_family='Alegreya Sans SC' color='#858b9a'>bt</span> {device_alias}",
        "format-connected-battery": "<span font_family='Alegreya Sans SC' color='#858b9a'>bt</span> {device_alias} {device_battery_percentage}%",
        "max-length": 60,  // counts the colour markup too (~30 chars), so names up to ~30 fit
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{controller_alias} · {num_connections} conectado(s)\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
        "on-click-right": "systemsettings kcm_bluetooth"
    },

    "custom/launcher": {
        "format": "<span color='#d6b16a'>✦</span>",
        "on-click": "pkill fuzzel || fuzzel",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "I", "2": "II", "3": "III", "4": "IV", "5": "V",
            "6": "VI", "7": "VII", "8": "VIII", "9": "IX", "11": "I", "12": "II", "13": "III", "14": "IV", "15": "V", "16": "VI", "17": "VII", "18": "VIII", "19": "IX", "default": "·"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 32,
        "separate-outputs": true
    },
    "clock": {
        "locale": "es_ES.utf8",
        "format": "{:L%A %e de %B  <span color='#e4dcc8'>%H:%M</span>}",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/calendar.sh",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#e4dcc8'><b>{}</b></span>",
                "weekdays": "<span color='#858b9a'>{}</span>",
                "today": "<span color='#d6b16a'><b>{}</b></span>"
            }
        }
    },
    "tray": { "icon-size": 14, "spacing": 8 },
    "pulseaudio": {
        "format": "<span font_family='Alegreya Sans SC' color='#858b9a'>vol</span> {volume}",
        "format-muted": "<span font_family='Alegreya Sans SC' color='#858b9a'>vol</span> <span color='#dc7f70'>silencio</span>",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },
    "backlight": {
        "format": "<span font_family='Alegreya Sans SC' color='#858b9a'>luz</span> {percent}"
    },
    "network": {
        "format-wifi": "<span font_family='Alegreya Sans SC' color='#858b9a'>red</span> {essid}",
        "format-ethernet": "<span font_family='Alegreya Sans SC' color='#858b9a'>red</span> cable",
        "format-disconnected": "<span font_family='Alegreya Sans SC' color='#858b9a'>red</span> <span color='#dc7f70'>sin</span>",
        "tooltip-format": "{ifname}  {ipaddr}  {signalStrength}%",
        "on-click": "systemsettings kcm_networkmanagement"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": { "default": "media", "performance": "plena", "balanced": "media", "power-saver": "reposo" }
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "<span font_family='Alegreya Sans SC' color='#858b9a'>bat</span> {capacity}",
        "format-charging": "<span font_family='Alegreya Sans SC' color='#858b9a'>carga</span> {capacity}",
        "format-plugged": "<span font_family='Alegreya Sans SC' color='#858b9a'>enchufe</span> {capacity}",
        "tooltip-format": "{timeTo}  ·  {power:.1f} W"
    },
    "custom/wallpaper": {
        "format": "<span font_family='Alegreya Sans SC' color='#858b9a'>lámina</span>",
        "on-click": "~/.config/hypr/scripts/wallpaper.sh",
        "tooltip-format": "Fondo de pantalla"
    },
    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "<span font_family='Alegreya Sans SC' color='#d6b16a'>avisos</span>",
            "none": "<span font_family='Alegreya Sans SC' color='#858b9a'>avisos</span>",
            "dnd-notification": "<span font_family='Alegreya Sans SC' color='#d6b16a'>mudo</span>",
            "dnd-none": "<span font_family='Alegreya Sans SC' color='#858b9a'>mudo</span>"
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/power": {
        "format": "<span font_family='Alegreya Sans SC' color='#858b9a'>fin</span>",
        "on-click": "~/.config/hypr/scripts/powermenu.sh",
        "tooltip": false
    }
}
