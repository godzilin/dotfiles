# Rojo: ink and red on newsprint (sourced by fish/config.fish)
set -gx BAT_THEME ansi
set -gx FZF_DEFAULT_OPTS "--color=light,bg+:#141414,bg:-1,fg:#141414,fg+:#efe6d2,hl:#d42a1e,hl+:#d42a1e,border:#141414,prompt:#d42a1e,pointer:#d42a1e,marker:#d42a1e,info:#8a8274,spinner:#d42a1e,header:#8a8274 --border=sharp --prompt='▶ ' --pointer='■'"
set -g fish_color_command 141414 --bold
set -g fish_color_param 2a2a2a
set -g fish_color_quote 3b5e3a
set -g fish_color_error d42a1e --bold
set -g fish_color_autosuggestion 8a8274
set -g fish_color_comment 8a8274
set -g fish_color_operator d42a1e
set -g fish_color_redirection d42a1e
set -g fish_color_valid_path --underline
