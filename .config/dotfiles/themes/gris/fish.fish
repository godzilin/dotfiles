# Gris palette for CLI tools (sourced by fish/config.fish)
set -gx BAT_THEME ansi
set -gx FZF_DEFAULT_OPTS "--color=bg+:#c8c8c8,bg:-1,fg:#222222,fg+:#000000,hl:#000000,hl+:#000000,border:#555555,prompt:#000000,pointer:#000000,marker:#555555,info:#555555,spinner:#000000,header:#555555 --border=rounded --prompt='› ' --pointer='▮'"
set -g fish_color_command 000000
set -g fish_color_param 222222
set -g fish_color_quote ffffff
set -g fish_color_error a02828
set -g fish_color_autosuggestion 777777
set -g fish_color_comment 555555
set -g fish_color_operator 000000
set -g fish_color_redirection 000000
set -g fish_color_valid_path --underline
