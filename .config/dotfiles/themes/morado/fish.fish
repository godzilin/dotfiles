# Yoru palette for CLI tools (sourced by fish/config.fish)
set -gx BAT_THEME ansi
set -gx FZF_DEFAULT_OPTS "--color=bg+:#2a2048,bg:-1,fg:#c4bbdc,fg+:#f1edf8,hl:#b79bff,hl+:#b79bff,border:#40316a,prompt:#b79bff,pointer:#b79bff,marker:#ff9a62,info:#8f80b8,spinner:#b79bff,header:#8f80b8 --border=rounded --prompt='› ' --pointer='▮'"
set -g fish_color_command f1edf8
set -g fish_color_param c4bbdc
set -g fish_color_quote ffcf6b
set -g fish_color_error ff6b6b
set -g fish_color_autosuggestion 5c4b8a
set -g fish_color_comment 8f80b8
set -g fish_color_operator b79bff
set -g fish_color_redirection b79bff
set -g fish_color_valid_path --underline
