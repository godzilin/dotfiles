{
    // Noche en Tokio: the bar is a pole of vertical street signs on the right edge, read from top to bottom.
    "layer": "top",
    "position": "right",
    "width": 48,
    "spacing": 3,

    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    "modules-center": ["clock", "custom/hizuke", "custom/weather"],
    "modules-right": ["group/media", "tray", "pulseaudio", "backlight", "network", "bluetooth", "power-profiles-daemon", "battery", "custom/wallpaper", "custom/claude", "custom/notifications", "custom/power"],

    "group/media": {
        "orientation": "vertical",
        "modules": ["image#cover", "mpris"]
    },
    "image#cover": {
        "exec": "cat ~/.cache/nostromo/cover-path 2>/dev/null | grep . || echo /nonexistent",
        "size": 30,
        "interval": 5,
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/media.sh"
    },
    "mpris": {
        "format": "{status_icon}",
        "status-icons": { "playing": "停", "paused": "再" },
        "tooltip-format": "{player}: {title}"
    },
    "custom/claude": {
        "exec": "~/.config/hypr/scripts/claude-spin.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": true
    },
    "custom/weather": {
        "justify": "center",
        "exec": "~/.config/hypr/scripts/weather.py bar | jq -c '.text |= (split(\" \") | join(\"\\n\"))'",
        "return-type": "json",
        "interval": 600,
        "on-click": "~/.config/hypr/scripts/weather.sh"
    },
    "bluetooth": {
        "justify": "center",
        "format": "藍\n{status}",
        "format-on": "藍\n入",
        "format-off": "藍\n切",
        "format-disabled": "藍\n切",
        "format-connected": "藍\n接",
        "format-connected-battery": "藍\n{device_battery_percentage}",
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{controller_alias} · {num_connections} conectado(s)\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
        "on-click-right": "systemsettings kcm_bluetooth"
    },
    "custom/launcher": {
        "format": "夜",
        "on-click": "pkill fuzzel || fuzzel",
        "tooltip-format": "Programas"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "default": "〇"
        },
        "persistent-workspaces": { "*": 4 },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "clock": {
        "justify": "center",
        "format": "{:%H\n%M}",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/calendar.sh"
    },
    // Weekday in kanji over the day of the month
    "custom/hizuke": {
        "justify": "center",
        "exec": "python3 -c \"import time; t = time.localtime(); print('月火水木金土日'[t.tm_wday] + chr(10) + str(t.tm_mday))\"",
        "interval": 600,
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/calendar.sh"
    },
    "tray": { "icon-size": 16, "spacing": 8 },
    "pulseaudio": {
        "justify": "center",
        "format": "音\n{volume}",
        "format-muted": "音\n消",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "Sonido: {desc}"
    },
    "backlight": { "justify": "center", "format": "光\n{percent}", "tooltip-format": "Brillo" },
    "network": {
        "justify": "center",
        "format-wifi": "網\n{signalStrength}",
        "format-ethernet": "網\n線",
        "format-disconnected": "網\n断",
        "tooltip-format": "{essid}  {ifname}  {ipaddr}",
        "on-click": "systemsettings kcm_networkmanagement"
    },
    "power-profiles-daemon": {
        "justify": "center",
        "format": "力\n{icon}",
        "format-icons": { "default": "中", "performance": "強", "balanced": "中", "power-saver": "弱" }
    },
    "battery": {
        "justify": "center",
        "states": { "warning": 25, "critical": 10 },
        "format": "電\n{capacity}",
        "format-charging": "充\n{capacity}",
        "format-plugged": "充\n{capacity}",
        "tooltip-format": "{timeTo}  ·  {power:.1f} W"
    },
    "custom/wallpaper": {
        "format": "絵",
        "on-click": "~/.config/hypr/scripts/wallpaper.sh",
        "tooltip-format": "Fondo de pantalla"
    },
    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": { "notification": "報", "none": "〇", "dnd-notification": "黙", "dnd-none": "黙" },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/power": {
        "format": "終",
        "on-click": "~/.config/hypr/scripts/powermenu.sh",
        "tooltip-format": "Apagar"
    }
}
