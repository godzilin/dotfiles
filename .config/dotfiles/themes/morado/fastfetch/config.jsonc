{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;195;174;230", "2": "38;2;157;123;255", "3": "38;2;106;74;158", "4": "38;2;45;226;230" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "",
    "key": { "width": 9 },
    "color": { "keys": "white", "title": "blue", "output": "default" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[90m────────────────────────────\u001b[0m" },
    { "type": "os",       "key": "OS",     "format": "{pretty-name}" },
    { "type": "kernel",   "key": "KERNEL" },
    { "type": "wm",       "key": "WM",     "format": "{pretty-name}" },
    { "type": "shell",    "key": "SHELL",  "format": "{pretty-name}" },
    { "type": "cpu",      "key": "CPU",    "format": "{name}" },
    { "type": "memory",   "key": "MEM",    "format": "{used} / {total}" },
    { "type": "disk",     "key": "DISK",   "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "battery",  "key": "BAT",    "format": "{capacity}" },
    { "type": "uptime",   "key": "UPTIME" }
  ]
}
