# Fósforo palette for CLI tools (sourced by fish/config.fish)
set -gx BAT_THEME ansi
set -gx FZF_DEFAULT_OPTS "--color=bg+:#0f1f10,bg:-1,fg:#63cc6c,fg+:#a6ffad,hl:#33ff4d,hl+:#33ff4d,border:#1a3a1d,prompt:#33ff4d,pointer:#33ff4d,marker:#8ce65a,info:#3f9147,spinner:#33ff4d,header:#3f9147 --border=sharp --prompt='> ' --pointer='▮'"
set -g fish_color_command a6ffad
set -g fish_color_param 63cc6c
set -g fish_color_quote c8ff5a
set -g fish_color_error ff5a4a
set -g fish_color_autosuggestion 275529
set -g fish_color_comment 3f9147
set -g fish_color_operator 33ff4d
set -g fish_color_redirection 33ff4d
set -g fish_color_valid_path --underline
