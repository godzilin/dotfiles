{
  "name": "Fósforo",
  "description": "Terminal de fósforo verde: negro puro, monocromo, todo en IBM 3270; la barra es una línea de estado",
  "palette": {
    "bg0": "#000000",
    "bg": "#040704",
    "bg1": "#091209",
    "bg2": "#0f1f10",
    "line": "#1a3a1d",
    "faint": "#275529",
    "muted": "#3f9147",
    "sub": "#63cc6c",
    "text": "#a6ffad",
    "accent": "#33ff4d",
    "yellow": "#c8ff5a",
    "orange": "#8ce65a",
    "red": "#ff5a4a",
    "green": "#5aff8c",
    "teal": "#4dd9a6",
    "blue": "#59c8a0"
  },
  "stripes": [
    "#a6ffad",
    "#33ff4d",
    "#1fb836",
    "#127a22"
  ],
  "font_ui": "3270 Nerd Font",
  "font_mono": "3270 Nerd Font Mono",
  "font_size": 11,
  "gtk_theme": "adw-gtk3-dark",
  "color_scheme": "prefer-dark",
  "icons": "Papirus-Verde",
  "cursor": "capitaine-cursors",
  "cursor_size": 24,
  "kde_colors": "Fosforo",
  "buttons": ":close",
  "daemons": ["~/.config/dotfiles/themes/negro/scripts/glitch.py"],
  "vscode": {
    "palette": {
      "bg": "#000000",
      "bg1": "#000000"
    },
    "settings": {
      "workbench.activityBar.location": "hidden",
      "workbench.editor.showTabs": "single",
      "workbench.layoutControl.enabled": false,
      "window.commandCenter": false,
      "window.menuBarVisibility": "toggle",
      "editor.cursorStyle": "block",
      "terminal.integrated.cursorStyle": "block",
      "editor.cursorBlinking": "solid",
      "editor.renderLineHighlight": "none",
      "editor.minimap.enabled": false,
      "editor.scrollbar.vertical": "hidden",
      "editor.folding": false,
      "editor.glyphMargin": false,
      "editor.smoothScrolling": false,
      "workbench.reduceMotion": "on",
      "breadcrumbs.enabled": false
    },
    "colors": {
      "statusBar.background": "#33ff4d",
      "statusBar.foreground": "#000000",
      "statusBar.border": "#33ff4d",
      "statusBar.noFolderBackground": "#33ff4d",
      "statusBarItem.hoverBackground": "#a6ffad",
      "statusBarItem.remoteBackground": "#a6ffad",
      "statusBarItem.remoteForeground": "#000000",
      "editor.selectionBackground": "#33ff4d40",
      "tab.activeBorderTop": "#00000000",
      "tab.border": "#000000",
      "terminal.ansiRed": "#ff5a4a",
      "terminal.ansiYellow": "#a6ffad",
      "terminal.ansiBlue": "#63cc6c",
      "terminal.ansiCyan": "#a6ffad",
      "terminal.ansiMagenta": "#63cc6c"
    },
    "tokens": {
      "comments": {
        "foreground": "#3f9147",
        "fontStyle": "italic"
      },
      "keywords": {
        "foreground": "#33ff4d",
        "fontStyle": "bold"
      },
      "strings": "#63cc6c",
      "numbers": "#c8ff5a",
      "types": {
        "foreground": "#a6ffad",
        "fontStyle": "underline"
      },
      "functions": {
        "foreground": "#a6ffad",
        "fontStyle": "bold"
      },
      "variables": "#a6ffad"
    }
  },
  "wallpaper": {
    "title": "FONDOS",
    "random": "ALEATORIO"
  }
}
